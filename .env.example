# Django
SECRET_KEY=change-me-in-production
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Security
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000

# Database (GLPI - MySQL / MariaDB)
# En docker-compose (microservicios) estas mismas variables se leen
# como GLPI_DB_HOST/GLPI_DB_USER/GLPI_DB_PASSWORD/GLPI_DB_NAME/GLPI_DB_PORT
# (ver docker-compose.yml, servicio "inventory") — mismos valores, prefijo
# distinto para no pisar el DB_* del monolito si corren en la misma máquina.
DB_ENGINE=django.db.backends.mysql
DB_HOST=change-me
DB_PORT=3306
DB_USER=change-me
DB_PASSWORD=change-me
DB_NAME=change-me
GLPI_DB_HOST=change-me
GLPI_DB_PORT=3306
GLPI_DB_USER=change-me
GLPI_DB_PASSWORD=change-me
GLPI_DB_NAME=change-me

# GLPI Base URL
GLPI_BASE_URL=change-me

# Circuit breaker (llamadas de inventory a la BD externa GLPI)
GLPI_BREAKER_FAIL_MAX=5
GLPI_BREAKER_RESET_TIMEOUT=30

# Cache-aside de lecturas a GLPI en segundos (0 desactiva el cacheo)
GLPI_CACHE_TTL_SECONDS=60

# Microservicios: BD propia por servicio. Sin engine/host, default =
# sqlite en BASE_DIR (dev local sin Docker). En docker-compose se
# fuerza Postgres (ver docker-compose.yml) — solo hace falta setear
# el *_PASSWORD de cada uno, el resto tiene default.
ACCOUNTS_DB_NAME=accounts
ACCOUNTS_DB_USER=accounts
ACCOUNTS_DB_PASSWORD=change-me
TICKETS_DB_NAME=tickets
TICKETS_DB_USER=tickets
TICKETS_DB_PASSWORD=change-me
INVENTORY_DB_NAME=inventory
INVENTORY_DB_USER=inventory
INVENTORY_DB_PASSWORD=change-me

# API Gateway: URLs de los servicios upstream + timeout de reenvío (segundos)
ACCOUNTS_SERVICE_URL=http://localhost:8001
TICKETS_SERVICE_URL=http://localhost:8002
INVENTORY_SERVICE_URL=http://localhost:8003
GATEWAY_UPSTREAM_TIMEOUT=10

# BFF (fase 1, ver .claude/plans/zippy-bubbling-pumpkin.md): único
# upstream es el Gateway, no los microservicios directamente.
GATEWAY_URL=http://localhost:8000
BFF_UPSTREAM_TIMEOUT=10
