# Django
SECRET_KEY=change-me-in-production
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Security
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000

# Database (GLPI - MySQL / MariaDB)
# En docker-compose (microservicios) estas mismas variables se leen
# como GLPI_DB_HOST/GLPI_DB_USER/GLPI_DB_PASSWORD/GLPI_DB_NAME/GLPI_DB_PORT
# (ver docker-compose.yml, servicio "inventory") — mismos valores, prefijo
# distinto para no pisar el DB_* del monolito si corren en la misma máquina.
DB_ENGINE=django.db.backends.mysql
DB_HOST=change-me
DB_PORT=3306
DB_USER=change-me
DB_PASSWORD=change-me
DB_NAME=change-me
GLPI_DB_HOST=change-me
GLPI_DB_PORT=3306
GLPI_DB_USER=change-me
GLPI_DB_PASSWORD=change-me
GLPI_DB_NAME=change-me

# GLPI Base URL
GLPI_BASE_URL=change-me

# Circuit breaker (llamadas de inventory a la BD externa GLPI)
GLPI_BREAKER_FAIL_MAX=5
GLPI_BREAKER_RESET_TIMEOUT=30

# Cache-aside de lecturas a GLPI en segundos (0 desactiva el cacheo)
GLPI_CACHE_TTL_SECONDS=60

# Microservicios: BD propia por servicio. Sin engine/host, default =
# sqlite en BASE_DIR (dev local sin Docker). En docker-compose se
# fuerza Postgres (ver docker-compose.yml) — solo hace falta setear
# el *_PASSWORD de cada uno, el resto tiene default.
ACCOUNTS_DB_NAME=accounts
ACCOUNTS_DB_USER=accounts
ACCOUNTS_DB_PASSWORD=change-me
TICKETS_DB_NAME=tickets
TICKETS_DB_USER=tickets
TICKETS_DB_PASSWORD=change-me
INVENTORY_DB_NAME=inventory
INVENTORY_DB_USER=inventory
INVENTORY_DB_PASSWORD=change-me

# API Gateway: URLs de los servicios upstream + timeout de reenvío (segundos)
ACCOUNTS_SERVICE_URL=http://localhost:8001
TICKETS_SERVICE_URL=http://localhost:8002
INVENTORY_SERVICE_URL=http://localhost:8003
GATEWAY_UPSTREAM_TIMEOUT=10

# BFF (ver .claude/plans/zippy-bubbling-pumpkin.md): único upstream es
# el Gateway, no los microservicios directamente.
GATEWAY_URL=http://localhost:8000
BFF_UPSTREAM_TIMEOUT=10

# BFF fase 2: sesión server-side en Redis (JWT nunca llega al browser)
# + CSRF double-submit. CSRF_TRUSTED_ORIGINS debe incluir el origin
# exacto del SPA (scheme+host+puerto) — el browser manda Origin en
# toda request cross-origin y Django la valida contra esta lista antes
# de mirar la cookie/header CSRF.
REDIS_URL=redis://localhost:6379/0
CSRF_TRUSTED_ORIGINS=http://localhost:5173

# Secreto compartido bff <-> accounts para auth/google-mint/. Requerido
# (sin default) en ambos servicios — generar con:
# python3 -c "import secrets; print(secrets.token_urlsafe(32))"
INTERNAL_AUTH_SECRET=change-me

# Login con Google (BFF, Authorization Code flow). Crear un OAuth
# Client ID tipo "Web application" en Google Cloud Console > APIs y
# servicios > Credenciales, con GOOGLE_REDIRECT_URI como "Authorized
# redirect URI" exacto. Vacío = la feature responde 503 sin romper nada.
GOOGLE_CLIENT_ID=change-me
GOOGLE_CLIENT_SECRET=change-me
GOOGLE_REDIRECT_URI=http://localhost:8010/api/v1/bff/auth/google/callback/
FRONTEND_URL=http://localhost:5173

# Email saliente (respuestas de ticket al solicitante, ver
# tickets/observers.py::_send_comment_reply_email). Sin
# EMAIL_HOST_USER/PASSWORD reales, el correo se imprime en el log
# (EMAIL_BACKEND por default = consola) en vez de salir de verdad.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=change-me
EMAIL_HOST_PASSWORD=change-me
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=no-reply@cmm.uchile.cl

# Umbral de confianza (0-1) del clasificador local de tickets (ver
# tickets/ml/). Por debajo de esto, la categoría sugerida no se aplica.
# Default razonable, no suele hacer falta tocarlo.
TICKET_AI_CONFIDENCE_THRESHOLD=0.5

# SLA plano en horas (ya no por prioridad — ver
# tickets/services/dashboard_service.py). Un ticket abierto más allá de
# este umbral cuenta como "vencido" en el dashboard.
TICKET_SLA_HOURS=8

# Ingesta de correo entrante (ver tickets/management/commands/
# poll_inbound_email.py): cada correo a esta casilla se convierte en
# ticket, o en respuesta de un ticket existente si el asunto trae su
# código. Vacío = el poller queda inactivo, no rompe nada. Servidor
# propio hoy (IMAP genérico) — mismo host funciona el día que migren a
# Google Workspace, sin cambios de código (solo cambiar estas vars).
INBOUND_EMAIL_HOST=change-me
INBOUND_EMAIL_PORT=993
INBOUND_EMAIL_USER=change-me
INBOUND_EMAIL_PASSWORD=change-me
INBOUND_EMAIL_USE_SSL=True
INBOUND_EMAIL_FOLDER=INBOX
INBOUND_EMAIL_POLL_INTERVAL_SECONDS=60

# Login LDAP institucional (junto a Google OAuth, ver
# config/settings.py). Vacío = LDAP desactivado, no rompe nada. Las 4
# cuentas de staff (Admin/Técnico) se provisionan a mano de antemano
# con su rol correcto — LDAP solo autentica, no asigna rol.
LDAP_SERVER_URI=change-me
LDAP_BIND_DN=change-me
LDAP_BIND_PASSWORD=change-me
LDAP_USER_SEARCH_BASE=change-me
